    private async Task StartEditing()
    {
        _isEditing = true;
        _editTitle = _doc?.Title ?? string.Empty;
        _editObservation = string.Empty;
        _editDate = _decryptedContent?.DocumentDate ?? _tz.ToUserTime(DateTime.UtcNow).Date;
        _editorInitialized = false;
        StateHasChanged();
        await Task.Delay(100);
        await InitEditorAsync();
        if (_decryptedContent is not null && _jsModule is not null)
            await _jsModule.InvokeVoidAsync("setContent", _editorId, _decryptedContent.HtmlContent);
    }

    private void CancelEdit()
    {
        _isEditing = false;
        _editorInitialized = false;
        if (_isNew) Nav.NavigateTo("/secure-docs");
    }

    private async Task SaveDocument()
    {
        if (_jsModule is null) return;
        _saving = true;
        StateHasChanged();

        var html = await _jsModule.InvokeAsync<string>("getContent", _editorId);
        if (string.IsNullOrWhiteSpace(html))
        {
            Snackbar.Add("El contenido no puede estar vacío", Severity.Warning);
            _saving = false;
            return;
        }

        if (_isNew)
        {
            var req = new CreateSecureDocumentRequest
            {
                Title = _editTitle,
                HtmlContent = html,
                Observation = _editObservation,
                DocumentDate = _editDate ?? DateTime.Now,
            };
            var resp = await Api.CreateAsync(req);
            if (resp?.Success == true)
            {
                Snackbar.Add("Documento creado y cifrado con AES-256", Severity.Success);
                _saving = false;
                Nav.NavigateTo($"/secure-docs/{resp.Data!.Id}", forceLoad: true);
                return;
            }
            Snackbar.Add("Error al guardar el documento", Severity.Error);
        }
        else
        {
            var req = new AddVersionRequest
            {
                HtmlContent = html,
                Observation = _editObservation,
                DocumentDate = _editDate ?? DateTime.Now,
            };
            var resp = await Api.AddVersionAsync(DocumentId!.Value, req);
            if (resp?.Success == true)
            {
                Snackbar.Add("Nueva versión guardada y cifrada", Severity.Success);
                _doc = resp.Data;
                _decryptedContent = null;
                _isEditing = false;
                _editorInitialized = false;
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Error al guardar la versión", Severity.Error);
            }
        }
        _saving = false;
    }

    private Task OpenDecryptDialogLatest() => OpenDecryptDialogForVersion(null);

    private async Task OpenDecryptDialogForVersion(int? versionId)
    {
        var parameters = new DialogParameters<DecryptDialog>
        {
            { x => x.DocumentId, DocumentId ?? 0 },
            { x => x.VersionId, versionId }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<DecryptDialog>("Descifrar documento", parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled == true || result?.Data is not DecryptRequest creds) return;

        var resp = await Api.DecryptAsync(DocumentId!.Value, creds);
        if (resp?.Success == true)
        {
            _decryptedContent = resp.Data;
            Snackbar.Add("Documento descifrado correctamente", Severity.Success);
        }
        else
        {
            Snackbar.Add("Credenciales incorrectas o documento no disponible", Severity.Error);
        }
        StateHasChanged();
    }

    // ── Impresión ─────────────────────────────────────────────────────

    private async Task PrintEncrypted()
    {
        if (_doc is null || _jsModule is null) return;
        var latest = _doc.Versions.OrderByDescending(v => v.VersionNumber).FirstOrDefault();
        if (latest is null) return;
        var meta = $"Versión {latest.VersionNumber} · " +
                   $"Fecha: {latest.DocumentDate:dd/MM/yyyy} · " +
                   $"Creado por: {latest.CreatedBy}";
        await _jsModule.InvokeVoidAsync("printDocument",
            _doc.Title, true, latest.EncryptedContent, meta);
    }

    private async Task PrintDecrypted()
    {
        if (_doc is null || _jsModule is null) return;
        if (_decryptedContent is not null)
        {
            await DoPrintDecrypted(_decryptedContent);
            return;
        }
        // No hay contenido descifrado — pedir credenciales primero
        await OpenDecryptDialogLatest();
        if (_decryptedContent is not null)
            await DoPrintDecrypted(_decryptedContent);
    }

    private async Task PrintVersion(int versionId)
    {
        if (_doc is null || _jsModule is null) return;
        // Si esa versión ya está descifrada, imprimir directo
        if (_decryptedContent?.VersionId == versionId)
        {
            await DoPrintDecrypted(_decryptedContent!);
            return;
        }
        // Pedir credenciales para esa versión
        var parameters = new DialogParameters<DecryptDialog>
        {
            { x => x.DocumentId, DocumentId ?? 0 },
            { x => x.VersionId,  versionId }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<DecryptDialog>("Descifrar para imprimir", parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled == true || result?.Data is not DecryptRequest creds) return;

        var resp = await Api.DecryptAsync(DocumentId!.Value, creds);
        if (resp?.Success == true && resp.Data is not null)
        {
            _decryptedContent = resp.Data;
            StateHasChanged();
            await DoPrintDecrypted(resp.Data);
        }
        else
        {
            Snackbar.Add("Credenciales incorrectas", Severity.Error);
        }
    }

    private async Task DoPrintDecrypted(DecryptedContentModel content)
    {
        if (_jsModule is null) return;
        var ver = _doc?.Versions.FirstOrDefault(v => v.Id == content.VersionId);
        var meta = $"Versión {content.VersionNumber} · " +
                   $"Fecha: {content.DocumentDate:dd/MM/yyyy} · " +
                   (string.IsNullOrWhiteSpace(ver?.Observation) ? "" : $"Obs: {ver!.Observation} · ") +
                   $"Descifrado por: {content.DecryptedBy}";
        await _jsModule.InvokeVoidAsync("printDocument",
            _doc!.Title, false, content.HtmlContent, meta);
    }

    private void GoBack() => Nav.NavigateTo("/secure-docs");

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            try { await _jsModule.InvokeVoidAsync("disposeEditor"); } catch { }
            await _jsModule.DisposeAsync();
        }
        _dotNetRef?.Dispose();
    }

