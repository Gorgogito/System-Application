@using BDAplication.Web.Models

<MudDialog Style="min-width:440px">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2"/>
            Editar Adjunto
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Attachment.OriginalName</MudText>

            <MudSelect T="int?" @bind-Value="_conceptId" Label="Concepto de Documento"
                       Variant="Variant.Outlined" Clearable="true" Placeholder="— Sin concepto —">
                @foreach (var c in Concepts)
                {
                    <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Name</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker @bind-Date="_docDate" Label="Fecha del Documento *"
                           Variant="Variant.Outlined" DateFormat="dd/MM/yyyy"
                           Required="true"
                           @onchange="@(() => _dateError = false)"/>
            @if (_dateError)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">La Fecha del Documento es obligatoria</MudText>
            }
            <MudTextField @bind-Value="_req.Description" Label="Descripción" Variant="Variant.Outlined"
                          MaxLength="200" Immediate="true"/>
            <MudTextField @bind-Value="_req.Comment" Label="Comentario" Variant="Variant.Outlined"
                          Lines="3" MaxLength="500" Immediate="true"/>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public AttachmentModel Attachment { get; set; } = default!;
    [Parameter] public List<DocumentConceptModel> Concepts { get; set; } = new();

    private UpdateAttachmentRequest _req = new();
    private DateTime? _docDate;
    private int? _conceptId;
    private bool _dateError;

    protected override void OnParametersSet()
    {
        _req.Description = Attachment.Description;
        _req.Comment = Attachment.Comment;
        _docDate = Attachment.DocumentDate;
        _conceptId = Attachment.DocumentConceptId;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!_docDate.HasValue) { _dateError = true; return; }
        _req.DocumentDate = _docDate.Value;
        _req.DocumentConceptId = _conceptId;
        MudDialog.Close(DialogResult.Ok(_req));
    }
}
