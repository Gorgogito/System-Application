@using BDAplication.Web.Models
@using BDAplication.Web.Services
@using MudBlazor
@inject TaskBoardApiService TaskBoardApi
@inject ISnackbar Snackbar
@inject IUserTimeZoneService _tz

<MudDialog Style="min-width:520px">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
            Editar Tarea
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudStack Spacing="3">

                <!-- Campos principales -->
                <MudTextField @bind-Value="_request.Title"
                              Label="Título"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El título es obligatorio"
                              MaxLength="200"
                              Counter="200"
                              Immediate="true" />

                <MudTextField @bind-Value="_request.Description"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Lines="3"
                              MaxLength="1000"
                              Counter="1000" />

                <MudSelect @bind-Value="_request.Priority"
                           Label="Prioridad"
                           Variant="Variant.Outlined"
                           T="Priority">
                    <MudSelectItem Value="Priority.Low">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Style="color:#4caf50;font-size:12px" />
                            <span>Baja</span>
                        </MudStack>
                    </MudSelectItem>
                    <MudSelectItem Value="Priority.Medium">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Style="color:#ff9800;font-size:12px" />
                            <span>Media</span>
                        </MudStack>
                    </MudSelectItem>
                    <MudSelectItem Value="Priority.High">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Style="color:#f44336;font-size:12px" />
                            <span>Alta</span>
                        </MudStack>
                    </MudSelectItem>
                    <MudSelectItem Value="Priority.Critical">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Style="color:#9c27b0;font-size:12px" />
                            <span>Crítica</span>
                        </MudStack>
                    </MudSelectItem>
                </MudSelect>

                <!-- Planificación -->
                <MudDivider />
                <MudText Typo="Typo.subtitle2" Style="font-weight:600">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Style="font-size:16px;vertical-align:middle;margin-right:4px" />
                    Planificación (opcional)
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">Inicio</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="7">
                        <MudDatePicker @bind-Date="_startDate" Label="Fecha"
                                       Variant="Variant.Outlined" DateFormat="dd/MM/yyyy"
                                       Clearable="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="5">
                        <MudTimePicker @bind-Time="_startTime" Label="Hora"
                                       Variant="Variant.Outlined" AmPm="false"
                                       Clearable="true" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.caption" Color="Color.Secondary">Finalización</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="7">
                        <MudDatePicker @bind-Date="_dueDate" Label="Fecha"
                                       Variant="Variant.Outlined" DateFormat="dd/MM/yyyy"
                                       Clearable="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="5">
                        <MudTimePicker @bind-Time="_dueTime" Label="Hora"
                                       Variant="Variant.Outlined" AmPm="false"
                                       Clearable="true" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>

                @if (_dateError != null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">@_dateError</MudAlert>
                }

                <MudGrid Spacing="2">
                    <MudItem xs="7">
                        <MudSelect T="int?" @bind-Value="_alertHours"
                                   Label="Alertar N horas antes"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   Placeholder="Sin alerta"
                                   Disabled="@(_dueDate is null)"
                                   Margin="Margin.Dense">
                            @foreach (var h in _alertOptions)
                            {
                                <MudSelectItem T="int?" Value="@h">@h hora(s)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="5">
                        <MudNumericField T="int?" @bind-Value="_customAlertHours"
                                         Label="Horas personalizadas"
                                         Variant="Variant.Outlined"
                                         Placeholder="Ej: 36"
                                         Min="1" Max="9999"
                                         Disabled="@(_dueDate is null)"
                                         Margin="Margin.Dense"
                                         Immediate="true" />
                    </MudItem>
                </MudGrid>

                <!-- Subtareas -->
                <MudDivider />
                <div>
                    <MudText Typo="Typo.subtitle2" Style="margin-bottom:8px;font-weight:600">
                        <MudIcon Icon="@Icons.Material.Filled.Checklist" Style="font-size:16px;vertical-align:middle;margin-right:4px" />
                        Subtareas (@_subtasks.Count(s => s.IsCompleted)/@_subtasks.Count)
                    </MudText>

                    @if (_subtasks.Count > 0)
                    {
                        <div style="max-height:180px;overflow-y:auto;margin-bottom:10px">
                            @foreach (var sub in _subtasks)
                            {
                                <div class="subtask-row @(sub.IsCompleted ? "subtask-done" : "")">
                                    <MudCheckBox T="bool"
                                                 Value="sub.IsCompleted"
                                                 ValueChanged="@(v => ToggleSubTask(sub))"
                                                 Color="Color.Success"
                                                 Dense="true" />
                                    <span class="subtask-title">@sub.Title</span>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Color="Color.Default"
                                                   OnClick="@(() => DeleteSubTask(sub))" />
                                </div>
                            }
                        </div>
                    }

                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_newSubTaskTitle"
                                      Placeholder="Nueva subtarea..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      @onkeydown="OnSubTaskKeyDown"
                                      Style="flex:1" />
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       Size="Size.Medium"
                                       Disabled="@string.IsNullOrWhiteSpace(_newSubTaskTitle)"
                                       OnClick="AddSubTask" />
                    </MudStack>
                </div>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="!_valid">Guardar</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .subtask-row {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 2px 0;
        border-radius: 6px;
        transition: background .15s;
    }
    .subtask-row:hover { background: rgba(0,0,0,.04); }
    .subtask-title { flex: 1; font-size: .88rem; line-height: 1.3; }
    .subtask-done .subtask-title { text-decoration: line-through; opacity: .55; }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TaskBoardModel Task { get; set; } = default!;

    private MudForm _form = default!;
    private bool _valid;
    private UpdateTaskBoardRequest _request = new();
    private List<SubTaskModel> _subtasks = new();
    private string _newSubTaskTitle = string.Empty;

    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _dueDate;
    private TimeSpan? _dueTime;
    private int? _alertHours;
    private int? _customAlertHours;
    private string? _dateError;

    private static readonly int[] _alertOptions = [1, 2, 6, 12, 24, 48, 72];

    private DateTime? StartDateUtc => _startDate.HasValue
        ? DateTime.SpecifyKind(_startDate.Value.Date + (_startTime ?? TimeSpan.Zero), DateTimeKind.Local).ToUniversalTime()
        : null;

    private DateTime? DueDateUtc => _dueDate.HasValue
        ? DateTime.SpecifyKind(_dueDate.Value.Date + (_dueTime ?? new TimeSpan(23, 59, 0)), DateTimeKind.Local).ToUniversalTime()
        : null;

    protected override void OnParametersSet()
    {
        _request = new UpdateTaskBoardRequest
        {
            Id          = Task.Id,
            Title       = Task.Title,
            Description = Task.Description,
            Priority    = Task.Priority
        };
        _subtasks = Task.SubTasks.ToList();

        if (Task.StartDate.HasValue)
        {
            var local = _tz.ToUserTime(Task.StartDate.Value);
            _startDate = local.Date;
            _startTime = local.TimeOfDay;
        }
        if (Task.DueDate.HasValue)
        {
            var local = _tz.ToUserTime(Task.DueDate.Value);
            _dueDate = local.Date;
            _dueTime = local.TimeOfDay;
        }

        if (Task.AlertHoursBeforeDue.HasValue)
        {
            if (_alertOptions.Contains(Task.AlertHoursBeforeDue.Value))
                _alertHours = Task.AlertHoursBeforeDue.Value;
            else
                _customAlertHours = Task.AlertHoursBeforeDue.Value;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (!_valid) return;

        var start = StartDateUtc;
        var due   = DueDateUtc;

        if (start.HasValue && due.HasValue && due.Value <= start.Value)
        {
            _dateError = "La fecha de finalización debe ser posterior a la fecha de inicio.";
            return;
        }

        _request.StartDate           = start;
        _request.DueDate             = due;
        _request.AlertHoursBeforeDue = _customAlertHours ?? _alertHours;

        MudDialog.Close(DialogResult.Ok(_request));
    }

    private async Task AddSubTask()
    {
        var title = _newSubTaskTitle.Trim();
        if (string.IsNullOrWhiteSpace(title)) return;
        var resp = await TaskBoardApi.CreateSubTaskAsync(new CreateSubTaskRequest
        {
            BoardTaskId = Task.Id,
            Title = title
        });
        if (resp?.Success == true && resp.Data is not null)
        {
            _subtasks.Add(resp.Data);
            Task.SubTasks.Add(resp.Data);
            _newSubTaskTitle = string.Empty;
        }
        else Snackbar.Add("Error al agregar subtarea", Severity.Error);
    }

    private async Task OnSubTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddSubTask();
    }

    private async Task ToggleSubTask(SubTaskModel sub)
    {
        var resp = await TaskBoardApi.ToggleSubTaskAsync(sub.Id);
        if (resp?.Success == true && resp.Data is not null)
        {
            sub.IsCompleted = resp.Data.IsCompleted;
            var parent = Task.SubTasks.FirstOrDefault(s => s.Id == sub.Id);
            if (parent is not null) parent.IsCompleted = resp.Data.IsCompleted;
        }
    }

    private async Task DeleteSubTask(SubTaskModel sub)
    {
        var resp = await TaskBoardApi.DeleteSubTaskAsync(sub.Id);
        if (resp?.Success == true)
        {
            _subtasks.Remove(sub);
            Task.SubTasks.Remove(Task.SubTasks.FirstOrDefault(s => s.Id == sub.Id)!);
        }
        else Snackbar.Add("Error al eliminar subtarea", Severity.Error);
    }
}
